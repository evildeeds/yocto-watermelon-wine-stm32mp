[submodule "layers/poky"]
	path = layers/poky
	url = https://git.yoctoproject.org/poky
[submodule "layers/meta-openembedded"]
	path = layers/meta-openembedded
	url = https://github.com/openembedded/meta-openembedded.git
[submodule "layers/meta-st/meta-st-openstlinux"]
	path = layers/meta-st/meta-st-openstlinux
	url = https://github.com/STMicroelectronics/meta-st-openstlinux.git
[submodule "layers/meta-st/meta-st-scripts"]
	path = layers/meta-st/meta-st-scripts
	url = https://github.com/STMicroelectronics/meta-st-scripts.git
[submodule "layers/meta-st/meta-st-stm32mp"]
	path = layers/meta-st/meta-st-stm32mp
	url = https://github.com/STMicroelectronics/meta-st-stm32mp.git
[submodule "layers/meta-st/meta-st-stm32mp-addons"]
	path = layers/meta-st/meta-st-stm32mp-addons
	url = https://github.com/STMicroelectronics/meta-st-stm32mp-addons.git
	branch = scarthgap
[submodule "layers/meta-watermelon-wine-stm32mp"]
	path = layers/meta-watermelon-wine-stm32mp
	url = https://github.com/evildeeds/meta-watermelon-wine-stm32mp.git
	branch = scarthgap
